{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://server-sigma-lake-31.vercel.app/api/:path*" },
    { "source": "/webhooks/:path*", "destination": "https://server-sigma-lake-31.vercel.app/webhooks/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
