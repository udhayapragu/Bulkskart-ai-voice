{
  "name": "bulkskart-voice-agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "node --env-file-if-exists=.env dist/db/migrate.js",
    "migrate:dev": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "hash-password": "node dist/scripts/hash-password.js",
    "seed:demo": "node --env-file-if-exists=.env dist/scripts/seed-demo.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
