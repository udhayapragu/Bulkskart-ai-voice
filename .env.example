# Copy to server/.env and fill in. Placeholders only: never commit real values.
# server/.env is git-ignored.

# ---- Runtime ----
NODE_ENV=development
PORT=8080
WEBSITE_URL=https://bulkskart.com
# Built dashboard directory, served by the API process. Leave commented out to run the
# API only. Set to the absolute path of web/dist for Option B deployment.
# WEB_DIST_DIR=/absolute/path/to/web/dist

# ---- Database: Supabase PostgreSQL ----
# memory   = not durable, local demos and tests only
# postgres = required for production
STORE_DRIVER=memory
# Supabase: Project Settings > Database > Connection string (use the session pooler
# if your network is IPv4-only). Use the database owner role, not the anon key.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ---- Admin sign-in ----
ADMIN_EMAIL=admin@example.com
# Generate: cd server && npm run hash-password -- "your long password"
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Generate: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=8

# ---- Voice AI (Sarvam AI) ----
# mock or sarvam. The sarvam adapter stays disabled until it is verified (see docs).
VOICE_PROVIDER=mock
SARVAM_API_KEY=

# ---- Telephony (Exotel) ----
# mock or exotel. The exotel adapter stays disabled until it is verified (see docs).
TELEPHONY_PROVIDER=mock
# Signs webhook requests (HMAC-SHA256). Generate: openssl rand -hex 32
TELEPHONY_WEBHOOK_SECRET=
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=

# ---- Calling safety ----
# Keep false until docs/PRODUCTION_READINESS.md is complete. Live calls also need a
# live telephony provider and a voice provider verified for live calls.
LIVE_CALLING_ENABLED=false
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
